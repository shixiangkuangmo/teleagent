# teleagent-dashboard 环境变量（复制为 .env 后修改；.env 已被 .gitignore 排除，不会提交）
# 用法：cp .env.example .env && 编辑 .env → docker compose up -d

# 面板登录保护（Basic Auth）——公网 / Cloudflare Tunnel 暴露前务必设置
# 未设置时不启用（仅适合本机 127.0.0.1 访问）
TA_PANEL_USER=admin
# 下面这行必须改成你自己的强密码，保持原样等于没设
TA_PANEL_PASSWORD=CHANGE-ME-strong-password

# 可选：不想让明文密码出现在 .env 时，改用哈希（二选一，哈希优先）
# 生成方式：node -e "console.log(require('crypto').createHash('sha256').update('admin:你的密码').digest('hex'))"
# TA_PANEL_PASSWORD_HASH=